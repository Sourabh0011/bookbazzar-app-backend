# ============================================================
# BookBazzar Backend – Environment Variables Example
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/bookbazzar
# Production example: mongodb+srv://<user>:<password>@cluster.mongodb.net/bookbazzar

# JWT
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_another_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# CORS – comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://10.0.2.2:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
