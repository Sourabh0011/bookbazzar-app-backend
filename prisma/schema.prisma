datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum Condition {
  LIKE_NEW
  GOOD
  ACCEPTABLE
}

enum BookStatus {
  ACTIVE
  SOLD
  INACTIVE
}

enum OrderStatus {
  PLACED
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum PaymentRecordStatus {
  PENDING
  COMPLETED
  FAILED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String      @id @default(uuid())
  fullName     String      @db.VarChar(100)
  email        String      @unique @db.VarChar(150)
  phone        String?     @db.VarChar(20)
  password     String      @db.VarChar(255)
  role         Role        @default(BUYER)
  profileImage String?     @db.VarChar(500)
  isVerified   Boolean     @default(false)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  addresses    Address[]
  books        Book[]      @relation("SellerBooks")
  cart         Cart?
  wishlist     Wishlist[]
  orders       Order[]     @relation("BuyerOrders")
  soldItems    OrderItem[] @relation("SellerOrderItems")

  @@map("users")
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  fullName    String   @db.VarChar(100)
  phone       String   @db.VarChar(20)
  addressLine String   @db.VarChar(255)
  city        String   @db.VarChar(80)
  state       String   @db.VarChar(80)
  postalCode  String   @db.VarChar(20)
  isDefault   Boolean  @default(false)

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@index([userId])
  @@map("addresses")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  image       String?  @db.VarChar(500)
  isActive    Boolean  @default(true)

  // Relations
  books       Book[]

  @@map("categories")
}

model Book {
  id            String      @id @default(uuid())
  sellerId      String
  categoryId    String
  title         String      @db.VarChar(255)
  author        String      @db.VarChar(150)
  description   String      @db.Text
  price         Decimal     @db.Decimal(10, 2)
  originalPrice Decimal?    @db.Decimal(10, 2)
  condition     Condition   @default(GOOD)
  coverImage    String?     @db.VarChar(500)
  stock         Int         @default(1)
  status        BookStatus  @default(ACTIVE)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  seller        User        @relation("SellerBooks", fields: [sellerId], references: [id], onDelete: Cascade)
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cartItems     CartItem[]
  wishlistItems Wishlist[]
  orderItems    OrderItem[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([price])
  @@map("books")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())

  // Relations
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  bookId    String
  quantity  Int      @default(1)

  // Relations
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([cartId, bookId])
  @@index([bookId])
  @@map("cart_items")
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  bookId    String
  createdAt DateTime @default(now())

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([bookId])
  @@map("wishlists")
}

model Order {
  id             String        @id @default(uuid())
  buyerId        String
  addressId      String?
  totalAmount    Decimal       @db.Decimal(10, 2)
  shippingAmount Decimal       @default(0) @db.Decimal(10, 2)
  status         OrderStatus   @default(PLACED)
  paymentStatus  PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())

  // Relations
  buyer          User          @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  address        Address?      @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  payment        Payment?

  @@index([buyerId])
  @@index([addressId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id       String  @id @default(uuid())
  orderId  String
  bookId   String
  sellerId String
  quantity Int     @default(1)
  price    Decimal @db.Decimal(10, 2)

  // Relations
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book     Book    @relation(fields: [bookId], references: [id], onDelete: Restrict)
  seller   User    @relation("SellerOrderItems", fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([bookId])
  @@index([sellerId])
  @@map("order_items")
}

model Payment {
  id            String              @id @default(uuid())
  orderId       String              @unique
  paymentMethod PaymentMethod       @default(COD)
  transactionId String?             @db.VarChar(100)
  amount        Decimal             @db.Decimal(10, 2)
  status        PaymentRecordStatus @default(PENDING)
  createdAt     DateTime            @default(now())

  // Relations
  order         Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}
